<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Stride</string>
    <string name="title_activity_main">Stride</string>
    <string name="package_name">app.stride.running</string>
    <string name="custom_url_scheme">app.stride.running</string>

    <!--
        The native Garmin screen.

        One screen, one thing on it: the key. The screen says what is
        happening - checking, syncing, connected, refused - and one line
        about privacy. Nothing else.
    -->
    <string name="garmin_title">Connect Garmin</string>
    <string name="garmin_key_hint">Paste the key Garmin showed you</string>
    <string name="garmin_show_key">Show the key</string>
    <string name="garmin_open_garmin">Get a key from Garmin</string>
    <string name="garmin_connect">Connect</string>
    <string name="garmin_replace_key">Replace key</string>
    <string name="garmin_disconnect">Disconnect Garmin</string>
    <string name="garmin_not_now">Not now</string>

    <!-- The states. These are the words the athlete reads. -->
    <string name="garmin_not_connected">Garmin is not connected.</string>
    <string name="garmin_connected">Connected</string>
    <string name="garmin_checking">Checking…</string>
    <string name="garmin_syncing">Syncing…</string>
    <string name="garmin_refused">Garmin did not accept this key.</string>
    <string name="garmin_failed">Garmin could not be reached.</string>
    <string name="garmin_key_too_short">That does not look like a Garmin key. Copy the whole thing.</string>
    <string name="garmin_no_browser">There is no browser on this phone to open Garmin.</string>
    <string name="garmin_credential_refused">Your phone\'s credential was not given. Nothing was changed.</string>

    <!-- The run count. "12 runs", and then "Connected · 160 runs". -->
    <plurals name="garmin_runs">
        <item quantity="one">%1$d run</item>
        <item quantity="other">%1$d runs</item>
    </plurals>
    <plurals name="garmin_connected_runs">
        <item quantity="one">Connected · %1$d run</item>
        <item quantity="other">Connected · %1$d runs</item>
    </plurals>

    <!-- The one line about privacy. There is only one. -->
    <string name="garmin_privacy">Your data stays on this phone.</string>

    <!-- What the phone answers instead of the routes it does not have. -->
    <string name="garmin_key_not_in_browser">The Garmin key is entered in the Stride app, not in the browser. The setup screen has opened.</string>
    <string name="garmin_password_not_supported">This phone connects with a Personal API key. It never asks for, and never stores, your Garmin password.</string>
    <string name="garmin_developer_key_not_supported">The phone connects with a Personal API key. There is no developer key here, and no OAuth client to use one with.</string>
    <string name="garmin_not_connected_error">Garmin is not connected on this phone.</string>
    <string name="garmin_key_locked">The phone is locked, so the key cannot be read. Unlock it and try again — your runs are still here.</string>
    <string name="garmin_key_gone">This phone\'s key store was reset, so the saved Garmin key cannot be read. Connect Garmin again.</string>
    <string name="screen_lock_required">Set a screen lock on this phone first. Stride will not keep your runs and your health data on a phone anyone can pick up.</string>

    <!-- The app gate. -->
    <string name="gate_title">Unlock Stride</string>
    <string name="gate_description">Your runs and your health data are behind your phone\'s screen lock.</string>
    <string name="gate_locked">Stride is locked.\n\nYour runs, your physiology and your plans are behind your phone\'s own credential.</string>
    <string name="gate_unlock">Unlock</string>

    <!-- The sync notifications. They say what happened and nothing about the
         athlete\'s health. -->
    <string name="sync_channel_name">Garmin sync</string>
    <string name="sync_channel_description">Says when Stride has pulled new runs from Garmin.</string>
    <string name="sync_in_progress_title">Syncing with Garmin</string>
    <string name="sync_in_progress_text">Fetching your runs and wellness.</string>
    <string name="sync_done_title">Stride is up to date</string>
    <string name="sync_failed_title">Stride could not reach Garmin</string>
</resources>
