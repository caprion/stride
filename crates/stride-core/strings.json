    { "id": "rest.count.below", "kind": "direction", "role": "arithmetic", "template": "{count} of {total} signals below your usual" },
    { "id": "rest.count.above", "kind": "direction", "role": "arithmetic", "template": "{count} of {total} signals above your usual" },
