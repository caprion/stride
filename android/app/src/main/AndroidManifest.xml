<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->

    <!-- The pull talks to Garmin, and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The sync notification. Android 13 and later ask the athlete; a
         refusal never disables the import or the browsing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The foreground service that holds a long pull. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        The application.

        **Nothing leaves the phone.** `allowBackup="false"` and the two rule
        files below: the database, the wrapped keys, the Garmin credential,
        the FIT blobs and the WebView's own storage are all excluded — from
        the cloud backup and from the device-to-device transfer alike.

        `allowBackup="false"` alone is not honoured on every manufacturer,
        which is why the backup rules are there as well.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!--
            The WebView's activity.

            It is the only exported component in the app, and it is exported
            because the launcher has to be able to start it. It has one
            intent filter: the launcher.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            The native Garmin setup screen.

            It is not exported: nothing outside the app may open it, and it
            never hands the key to anything. It is the only place the Garmin
            key is typed, which is what keeps the credential out of the
            WebView.

            Its own theme, so the system splash is not drawn over the screen
            the athlete is trying to read. The screen keeps its layout when
            the phone is turned: a pull can take a while, and the athlete
            should not lose the count by turning the phone.
        -->
        <activity
            android:name=".setup.GarminSetupActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:label="@string/garmin_title"
            android:theme="@style/AppTheme.GarminSetup" />

        <!--
            The foreground service for a long pull.

            It is WorkManager's own: a pull can outlast the system's
            patience with a background job, and the job holds a foreground
            notification while it runs. The type has to be declared here,
            because the platform refuses a foreground service whose type is
            not a subset of the one in the manifest — and the type is
            `dataSync`, which is what a pull is.

            WorkManager brings its own provider and receiver, and the merged
            manifest declares them unexported: nothing outside the app may
            drive the phone's background work.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
