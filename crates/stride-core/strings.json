    { "id": "update.payload.note.laps", "kind": "instruction", "role": null, "template": "Each line of the laps is one lap of the run: its number, how far that lap covered, its pace and its average heart rate. A lap is not a kilometre — the laps of a run do not add up to a kilometre count." },
    { "id": "update.payload.note.zones", "kind": "instruction", "role": null, "template": "The zones are the athlete's own zones, read from the app: the first band is the slowest and the last the fastest. The share is the share of the run's time in that band." },
    { "id": "update.payload.note.pace_drift", "kind": "instruction", "role": null, "template": "Pace drift is the second half's average pace minus the first half's, in seconds per kilometre. A negative pace drift means the second half was the faster half." },
    { "id": "update.payload.note.heart_rate_drift", "kind": "instruction", "role": null, "template": "Heart rate drift is the second half's average heart rate minus the first half's, in beats per minute. A positive drift means the heart rate rose." },
    { "id": "update.payload.note.cadence_drift", "kind": "instruction", "role": null, "template": "Cadence drift is the last third's average cadence minus the first third's, as a percentage. A positive drift means the cadence rose." },
    { "id": "update.payload.note.aerobic_decoupling", "kind": "instruction", "role": null, "template": "Aerobic decoupling is the first third's efficiency minus the last third's. A positive decoupling means the efficiency fell as the run went on, and a negative one means it rose." },
    { "id": "update.payload.note.observations", "kind": "instruction", "role": null, "template": "Each line of the observations is one measurement of the run, with the direction the app read in it: faster, slower, higher, lower or held." },
